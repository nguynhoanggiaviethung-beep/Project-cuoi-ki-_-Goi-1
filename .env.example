# Copy to .env and fill locally. Never commit .env.
# SSI API Key and API Secret are used for read-only market data.
SSI_API_KEY=
SSI_API_SECRET=
# Optional client ID, if SSI provided one separately.
# Private Key is not used for read-only market quote streaming.
SSI_CLIENT_ID=
WATCHLIST=FPT,HPG,VPB
# Map each watched symbol to its exchange once verified: FPT:HOSE,ABC:HNX,XYZ:UPCOM
SYMBOL_MARKETS=FPT:HOSE,HPG:HOSE,VPB:HOSE
DB_PATH=database/sli.sqlite3
STALE_AFTER_SECONDS=120
BASELINE_MIN_BARS=60
BASELINE_SESSIONS=10
MIN_BAR_SNAPSHOTS=1
ALERT_CONSECUTIVE_BARS=3
ALERT_COOLDOWN_MIN=15
MIN_BARS_FOR_RANKING=30
RANKING_MIN_BARS=30
RANKING_MIN_SNAPSHOTS=30
SPREAD_PERCENTILE=90
DEPTH_PERCENTILE=10
IMBALANCE_THRESHOLD=0.60
RECONNECT_MAX_SECONDS=30
# SSI historical REST sync: paced sequential requests plus transient-error retries.
HISTORY_REST_MIN_INTERVAL_SECONDS=0.5
HISTORY_REST_MAX_RETRIES=4
HISTORY_REST_MAX_BACKOFF_SECONDS=30
# SSI DailyOhlc backfill from Vietnam market inception; actual oldest row depends on SSI availability per symbol.
HISTORY_START_DATE=2000/01/01
HISTORY_REST_PAGE_SIZE=1000
HISTORY_REST_MAX_PAGES=10
# Delayed/out-of-order quotes are retained for audit and excluded from minute bars.
MAX_EVENT_DELAY_SECONDS=30
CLOCK_SKEW_TOLERANCE_SECONDS=5
SLI_HOST=127.0.0.1
SLI_PORT=8000
# Market clock defaults to the real Asia/Ho_Chi_Minh clock. Set holidays as comma-separated YYYY-MM-DD dates.
MARKET_HOLIDAYS=
MARKET_REFRESH_SECONDS=5
# Optional test-only clock. Leave empty for real time; enable only on a local test copy.
MARKET_CLOCK_OVERRIDE=
MARKET_CLOCK_SPEED=1
