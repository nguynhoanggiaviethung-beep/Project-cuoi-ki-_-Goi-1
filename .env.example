# Copy to .env and fill locally. Never commit .env.
VPBS_USERNAME=your_custody_login
VPBS_PASSWORD=your_password
NEO_WS_URL=wss://neoapi.vpbanks.com.vn/stock-stream/broker
WATCHLIST=FPT,HPG,VPB
# Map every watched symbol to its exchange once verified: FPT:HOSE,ABC:HNX,XYZ:UPCOM
SYMBOL_MARKETS=FPT:HOSE,HPG:HOSE,VPB:HOSE
DB_PATH=database/sli.sqlite3
STALE_AFTER_SECONDS=120
BASELINE_MIN_BARS=60
BASELINE_SESSIONS=10
MIN_BAR_SNAPSHOTS=1
ALERT_CONSECUTIVE_BARS=3
ALERT_COOLDOWN_MIN=15
RANKING_MIN_BARS=30
RANKING_MIN_SNAPSHOTS=30
SPREAD_PERCENTILE=90
DEPTH_PERCENTILE=10
IMBALANCE_THRESHOLD=0.60
RECONNECT_MAX_SECONDS=30
SLI_HOST=127.0.0.1
SLI_PORT=8000
