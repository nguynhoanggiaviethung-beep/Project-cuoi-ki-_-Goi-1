# Copy to .env and fill locally. Never commit .env.
# SSI API Key and API Secret are used for read-only market data.
SSI_API_KEY=
SSI_API_SECRET=
# Optional client ID, if SSI provided one separately.
# Private Key is not used for read-only market quote streaming.
SSI_CLIENT_ID=
WATCHLIST=FPT,HPG,VPB
# Map each watched symbol to its exchange once verified: FPT:HOSE,ABC:HNX,XYZ:UPCOM
SYMBOL_MARKETS=FPT:HOSE,HPG:HOSE,VPB:HOSE
DB_PATH=database/sli.sqlite3
STALE_AFTER_SECONDS=120
BASELINE_MIN_BARS=60
BASELINE_SESSIONS=10
MIN_BAR_SNAPSHOTS=1
ALERT_CONSECUTIVE_BARS=3
ALERT_COOLDOWN_MIN=15
RANKING_MIN_BARS=30
RANKING_MIN_SNAPSHOTS=30
SPREAD_PERCENTILE=90
DEPTH_PERCENTILE=10
IMBALANCE_THRESHOLD=0.60
RECONNECT_MAX_SECONDS=30
SLI_HOST=127.0.0.1
SLI_PORT=8000
