# Copy to .env and fill locally. Never commit .env.
VPBS_USERNAME=your_custody_login
VPBS_PASSWORD=your_password
NEO_WS_URL=wss://neoapi.vpbanks.com.vn/stock-stream/broker
WATCHLIST=FPT,HPG,VPB
DB_PATH=database/sli.sqlite3
STALE_AFTER_SECONDS=120
BASELINE_MIN_OBSERVATIONS=100
SPREAD_PERCENTILE=90
DEPTH_PERCENTILE=10
IMBALANCE_THRESHOLD=0.60
RECONNECT_MAX_SECONDS=30
SLI_HOST=127.0.0.1
SLI_PORT=8000